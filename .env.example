# =====================================================================
# SOET College Website - Environment Configuration
# =====================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/project

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=soet_college
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# AI Chatbot & OpenAI Integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Mailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=admissions@mgmu.ac.in
SMTP_FROM_NAME="SOET Admissions"

# Session & Security
SESSION_LIFETIME=3600
CSRF_TOKEN_NAME=soet_csrf_token
DEV_MASTER_PASSWORD=DevMaster@SOET2026!
